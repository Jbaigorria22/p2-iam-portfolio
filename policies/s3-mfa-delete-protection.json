{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowS3ReadAlways",
            "Effect": "Allow",
            "Action": [
                "s3:ListAllMyBuckets",
                "s3:GetObject"
            ],
            "Resource": "*"
        },
        {
            "Sid": "DenyS3DeleteWithoutMFA",
            "Effect": "Deny",
            "Action": [
                "s3:DeleteObject",
                "s3:DeleteBucket"
            ],
            "Resource": "*",
            "Condition": {
                "BoolIfExists": {
                    "aws:MultiFactorAuthPresent": "false"
                }
            }
        }
    ]
}
