{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowS3SaEast1Only",
            "Effect": "Allow",
            "Action": [
                "s3:ListAllMyBuckets",
                "s3:GetObject",
                "s3:PutObject"
            ],
            "Resource": "*",
            "Condition": {
                "StringEquals": {
                    "aws:RequestedRegion": "sa-east-1"
                }
            }
        }
    ]
}
