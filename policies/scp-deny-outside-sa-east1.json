{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "DenyOutsideSaEast1",
            "Effect": "Deny",
            "NotAction": [
                "iam:*",
                "organizations:*",
                "support:*",
                "sts:*"
            ],
            "Resource": "*",
            "Condition": {
                "StringNotEquals": {
                    "aws:RequestedRegion": "sa-east-1"
                }
            }
        }
    ]
}
